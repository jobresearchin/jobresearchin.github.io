---
pagination:
  data: translations
  size: 1
  alias: lang
permalink: "{% if lang.key == 'ja' %}/{% else %}/{{ lang.key }}/{% endif %}index.html"
---

<!DOCTYPE html>
<html lang="{{ lang.key }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ lang.meta.title }}</title>
  <meta name="description" content="{{ lang.meta.description }}" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="alternate" hreflang="ja" href="https://corp.jobresearchin.com/" />
  <link rel="alternate" hreflang="en" href="https://corp.jobresearchin.com/en/" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="{{ lang.meta.title }}" />
  <meta property="og:description" content="{{ lang.meta.description }}" />
  <meta property="og:image" content="https://corp.jobresearchin.com/static/og-image.jpg" />
  <meta property="og:url" content="https://corp.jobresearchin.com/{% if lang.key == 'ja' %}{% else %}en/{% endif %}" />
  <meta property="og:site_name" content="{{ lang.meta.siteName }}" />
  <meta name="twitter:card" content="summary_large_image" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-X754F6MGCM"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-X754F6MGCM');
  </script>
</head>

<body class="home-page">
  <a class="skip-link" href="#main-content">{% if lang.key == 'ja' %}本文へ移動{% else %}Skip to content{% endif %}</a>

  <div class="mobile-sidebar" id="mobile-sidebar" aria-hidden="true" inert>
    <div class="mobile-sidebar-head">
      <span class="mobile-menu-label">MENU</span>
      <button class="menu-close-btn" id="menu-close-btn" aria-label="{% if lang.key == 'ja' %}メニューを閉じる{% else %}Close menu{% endif %}">
        <span></span><span></span>
      </button>
    </div>
    <nav aria-label="{% if lang.key == 'ja' %}モバイルナビゲーション{% else %}Mobile navigation{% endif %}">
      <ul>
        <li><a href="#service-overview" class="menu-link"><span>01</span>{{ lang.header.navOverview }}</a></li>
        <li><a href="#researchers" class="menu-link"><span>02</span>{{ lang.header.navResearchers }}</a></li>
        <li><a href="#participants" class="menu-link"><span>03</span>{{ lang.header.navParticipants }}</a></li>
        <li><a href="#usage-guide" class="menu-link"><span>04</span>{% if lang.key == 'ja' %}使い方{% else %}How it works{% endif %}</a></li>
        <li><a href="#businesses" class="menu-link"><span>05</span>{{ lang.header.navServices }}</a></li>
        <li><a href="#company" class="menu-link"><span>06</span>{{ lang.header.navCompany }}</a></li>
        <li><a href="{% if lang.key == 'ja' %}/news/{% else %}/{{ lang.key }}/news/{% endif %}" class="menu-link"><span>07</span>{{ lang.header.navNews }}</a></li>
      </ul>
    </nav>
    <div class="mobile-sidebar-actions">
      <a href="{{ lang.header.navContactLink }}" class="btn btn-primary" target="_blank" rel="noopener noreferrer">{{ lang.header.navContact }}</a>
    </div>
  </div>
  <div class="sidebar-overlay" id="sidebar-overlay"></div>

  <div class="site-wrapper">
    <header class="site-header">
      <div class="nav-container">
        <a href="{% if lang.key == 'ja' %}/{% else %}/{{ lang.key }}/{% endif %}" class="brand-logo" aria-label="Researchin {% if lang.key == 'ja' %}ホーム{% else %}home{% endif %}">
          {% image "static/logo.png", "Researchin", "(max-width: 600px) 145px, 180px" %}
        </a>
        <nav class="desktop-nav" aria-label="{% if lang.key == 'ja' %}メインナビゲーション{% else %}Main navigation{% endif %}">
          <a href="#service-overview">{{ lang.header.navOverview }}</a>
          <a href="#researchers">{{ lang.header.navResearchers }}</a>
          <a href="#participants">{{ lang.header.navParticipants }}</a>
          <a href="#usage-guide">{% if lang.key == 'ja' %}使い方{% else %}How it works{% endif %}</a>
          <a href="#businesses">{{ lang.header.navServices }}</a>
          <a href="#company">{{ lang.header.navCompany }}</a>
        </nav>
        <div class="header-right">
          <div class="lang-switcher header-lang-switcher" aria-label="Language">
            <a href="/" {% if lang.key=='ja' %}class="active" aria-current="page"{% endif %}>JP</a>
            <span aria-hidden="true">/</span>
            <a href="/en/" {% if lang.key=='en' %}class="active" aria-current="page"{% endif %}>EN</a>
          </div>
          <a href="{{ lang.header.navContactLink }}" class="btn btn-header" target="_blank" rel="noopener noreferrer">{{ lang.header.navContact }}</a>
          <button class="hamburger-menu" id="hamburger-menu" aria-label="{% if lang.key == 'ja' %}メニューを開く{% else %}Open menu{% endif %}" aria-controls="mobile-sidebar" aria-expanded="false">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content">
      <section class="hero-home" id="hero">
        <div class="container hero-home-layout">
          <div class="hero-copy">
            <p class="eyebrow">RESEARCH RECRUITMENT PLATFORM</p>
            <h1>
              <span class="hero-title-desktop">
                {% if lang.key == 'ja' %}
                <span>研究する人と、</span>
                <span>参加する人をつなぐ。</span>
                {% else %}
                <span>Where researchers and</span>
                <span>participants meet.</span>
                {% endif %}
              </span>
              <span class="hero-title-mobile">{% if lang.key == 'ja' %}研究を当たり前に{% else %}Research for everyone.{% endif %}</span>
            </h1>
            <p class="hero-lead">
              <span class="hero-lead-desktop">{{ lang.hero.subtitle }}</span>
              <span class="hero-lead-mobile">{% if lang.key == 'ja' %}研究・調査の参加者募集と応募をスムーズに{% else %}Smoother study recruitment and applications{% endif %}</span>
            </p>
            <div class="hero-actions">
              <a href="{{ lang.hero.participantBtnLink }}" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                {{ lang.hero.participantBtnText }}
              </a>
              <a href="{{ lang.researchers.btnLink }}" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
                {% if lang.key == 'ja' %}参加者募集を相談する{% else %}Discuss participant recruitment{% endif %}
              </a>
            </div>
          </div>
          <div class="hero-product" aria-label="{% if lang.key == 'ja' %}Researchinの研究募集一覧画面{% else %}Researchin study listings interface{% endif %}">
            <div class="product-window">
              <div class="product-window-bar">
                <span></span><span></span><span></span>
                <strong>jobresearchin.com</strong>
              </div>
              <div class="product-window-screen">
                {% image lang.guide.step1.image, lang.guide.step1.alt, "(max-width: 960px) 100vw, 50vw" %}
              </div>
            </div>
            <p class="product-caption"><span></span>{% if lang.key == 'ja' %}条件を見比べながら、参加したい研究を探せます{% else %}Compare study conditions before choosing where to participate{% endif %}</p>
          </div>
        </div>
      </section>

      <section class="trust-strip" aria-label="{% if lang.key == 'ja' %}Researchinが大切にしていること{% else %}What Researchin is built for{% endif %}">
        <div class="container trust-grid">
          <div class="trust-item">
            <span>FOR RESEARCHERS</span>
            <strong>{% if lang.key == 'ja' %}募集にかかる手間を軽く{% else %}Less recruitment work{% endif %}</strong>
          </div>
          <div class="trust-item">
            <span>FOR PARTICIPANTS</span>
            <strong>{% if lang.key == 'ja' %}研究との出会いを身近に{% else %}Easier access to studies{% endif %}</strong>
          </div>
          <div class="trust-item">
            <span>TRANSPARENCY</span>
            <strong>{% if lang.key == 'ja' %}条件・内容・謝礼を明確に{% else %}Clear terms and rewards{% endif %}</strong>
          </div>
        </div>
      </section>

      <section id="service-overview" class="section overview-section">
        <div class="container">
          <div class="section-intro split-intro">
            <div>
              <p class="section-label">ABOUT RESEARCHIN</p>
              <h2>{{ lang.overview.title }}</h2>
            </div>
            <p>{{ lang.overview.subtitle }}</p>
          </div>
          <div class="principles-grid">
            <article class="principle-item">
              <span>01</span>
              <h3>{{ lang.overview.feature1.title }}</h3>
              <p>{{ lang.overview.feature1.desc }}</p>
            </article>
            <article class="principle-item">
              <span>02</span>
              <h3>{{ lang.overview.feature2.title }}</h3>
              <p>{{ lang.overview.feature2.desc }}</p>
            </article>
            <article class="principle-item">
              <span>03</span>
              <h3>{{ lang.overview.feature3.title }}</h3>
              <p>{{ lang.overview.feature3.desc }}</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section audience-section" aria-labelledby="audience-heading">
        <div class="container">
          <div class="audience-heading">
            <p class="section-label section-label-light">FOR EVERY SIDE OF RESEARCH</p>
            <h2 id="audience-heading">{% if lang.key == 'ja' %}研究する人と、参加する人へ。{% else %}For both sides of research.{% endif %}</h2>
          </div>
          <div class="audience-grid">
            <article class="audience-panel audience-researcher" id="researchers">
              <p class="audience-number">01 / RESEARCHERS</p>
              <h3>{{ lang.researchers.title }}</h3>
              <p class="audience-lead">{{ lang.researchers.subtitle }}</p>
              <ul>
                <li>{{ lang.researchers.point1 }}</li>
                <li>{{ lang.researchers.point2 }}</li>
                <li>{{ lang.researchers.point3 }}</li>
              </ul>
              <a href="{{ lang.researchers.btnLink }}" class="btn btn-light" target="_blank" rel="noopener noreferrer">{{ lang.researchers.btnText }}</a>
            </article>
            <article class="audience-panel audience-participant" id="participants">
              <p class="audience-number">02 / PARTICIPANTS</p>
              <h3>{% if lang.key == 'ja' %}研究に参加したい方へ{% else %}{{ lang.participants.title }}{% endif %}</h3>
              <p class="audience-lead">{{ lang.participants.subtitle }}</p>
              <ul>
                <li>{{ lang.participants.point1 }}</li>
                <li>{{ lang.participants.point2 }}</li>
                <li>{{ lang.participants.point3 }}</li>
              </ul>
              <a href="{{ lang.participants.btnLink }}" class="btn btn-dark" target="_blank" rel="noopener noreferrer">{{ lang.participants.btnText }}</a>
            </article>
          </div>
        </div>
      </section>

      <section id="usage-guide" class="section guide-section">
        <div class="container">
          <div class="section-intro split-intro">
            <div>
              <p class="section-label">HOW IT WORKS</p>
              <h2>{% if lang.key == 'ja' %}参加までの3ステップ{% else %}Join in 3 steps{% endif %}</h2>
            </div>
            <p>{{ lang.guide.subtitle }}</p>
          </div>

          <div class="guide-list">
            <article class="guide-row">
              <div class="guide-copy">
                <span class="guide-number">01</span>
                <h3>{{ lang.guide.step1.title }}</h3>
                <p>{{ lang.guide.step1.description }}</p>
              </div>
              <div class="guide-visual guide-visual-list">
                {% image lang.guide.step1.image, lang.guide.step1.alt, "(max-width: 960px) 100vw, 55vw" %}
              </div>
            </article>
            <article class="guide-row guide-row-reverse">
              <div class="guide-copy">
                <span class="guide-number">02</span>
                <h3>{{ lang.guide.step2.title }}</h3>
                <p>{{ lang.guide.step2.description }}</p>
              </div>
              <div class="guide-visual">
                {% image lang.guide.step2.image, lang.guide.step2.alt, "(max-width: 960px) 100vw, 55vw" %}
              </div>
            </article>
            <article class="guide-row">
              <div class="guide-copy">
                <span class="guide-number">03</span>
                <h3>{{ lang.guide.step3.title }}</h3>
                <p>{{ lang.guide.step3.description }}</p>
              </div>
              <div class="guide-visual guide-visual-form">
                {% image lang.guide.step3.image, lang.guide.step3.alt, "(max-width: 960px) 100vw, 55vw" %}
              </div>
            </article>
          </div>

          <details class="guide-details">
            <summary>{{ lang.guide.detailedSteps.title }}<span aria-hidden="true"></span></summary>
            <div class="guide-details-grid">
              <div><strong>{{ lang.guide.detailedSteps.step4.title }}</strong><p>{{ lang.guide.detailedSteps.step4.description }}</p></div>
              <div><strong>{{ lang.guide.detailedSteps.step5.title }}</strong><p>{{ lang.guide.detailedSteps.step5.description }}</p></div>
              <div><strong>{{ lang.guide.detailedSteps.step6.title }}</strong><p>{{ lang.guide.detailedSteps.step6.description }}</p></div>
              <div><strong>{{ lang.guide.detailedSteps.step7.title }}</strong><p>{{ lang.guide.detailedSteps.step7.description }}</p></div>
              <div><strong>{{ lang.guide.detailedSteps.step8.title }}</strong><p>{{ lang.guide.detailedSteps.step8.description }}</p></div>
              <div><strong>{{ lang.guide.helpSection.title }}</strong><p>{{ lang.guide.helpSection.description }}</p></div>
            </div>
          </details>
        </div>
      </section>

      <section id="businesses" class="section business-section">
        <div class="container">
          <div class="section-intro split-intro">
            <div>
              <p class="section-label">OUR SERVICES</p>
              <h2>{{ lang.businesses.title }}</h2>
            </div>
            <p>{% if lang.key == 'ja' %}研究を身近にするために、募集プラットフォームのほかにも、研究現場を支える仕事に取り組んでいます。{% else %}Alongside our recruitment platform, we provide practical support for the people and organizations conducting research.{% endif %}</p>
          </div>
          <div class="business-list">
            <a href="{% if lang.key == 'ja' %}/services/administrative-support/{% else %}/{{ lang.key }}/services/administrative-support/{% endif %}" class="business-row">
              <span class="business-number">01</span>
              <div><h3>{{ lang.businesses.item1.title }}</h3><p>{{ lang.businesses.item1.desc }}</p></div>
            </a>
            <a href="{% if lang.key == 'ja' %}/services/website-development/{% else %}/{{ lang.key }}/services/website-development/{% endif %}" class="business-row">
              <span class="business-number">02</span>
              <div><h3>{{ lang.businesses.item2.title }}</h3><p>{{ lang.businesses.item2.desc }}</p></div>
            </a>
            <a href="{% if lang.key == 'ja' %}/services/tour-organization/{% else %}/{{ lang.key }}/services/tour-organization/{% endif %}" class="business-row">
              <span class="business-number">03</span>
              <div><h3>{{ lang.businesses.item3.title }}</h3><p>{{ lang.businesses.item3.desc }}</p></div>
            </a>
          </div>
        </div>
      </section>

      <section id="upcoming-features" class="section roadmap-section">
        <div class="container">
          <div class="section-intro split-intro">
            <div>
              <p class="section-label">ROADMAP</p>
              <h2>{{ lang.features.title }}</h2>
            </div>
            <p>{{ lang.features.subtitle }}</p>
          </div>
          <div class="roadmap-grid">
            <article><span>ROADMAP / 01</span><h3>{{ lang.features.feature1.title }}</h3><p>{{ lang.features.feature1.desc }}</p></article>
            <article><span>ROADMAP / 02</span><h3>{{ lang.features.feature2.title }}</h3><p>{{ lang.features.feature2.desc }}</p></article>
            <article><span>ROADMAP / 03</span><h3>{{ lang.features.feature3.title }}</h3><p>{{ lang.features.feature3.desc }}</p></article>
            <article><span>ROADMAP / 04</span><h3>{{ lang.features.feature4.title }}</h3><p>{{ lang.features.feature4.desc }}</p></article>
          </div>
        </div>
      </section>

      <section class="section news-section">
        <div class="container">
          <div class="news-home-head">
            <div><p class="section-label">NEWS</p><h2>{{ lang.news.title }}</h2></div>
            <a href="{% if lang.key == 'ja' %}/news/{% else %}/{{ lang.key }}/news/{% endif %}" class="text-link">{% if lang.key == 'ja' %}一覧を見る{% else %}View all{% endif %}</a>
          </div>
          <div class="news-home-list">
            {% for item in lang.news.items %}
            <article class="news-home-row">
              <time datetime="{{ item.date }}">{{ item.displayDate }}</time>
              <span>{{ item.category }}</span>
              <h3>{{ item.title }}</h3>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>

      <section id="company" class="section company-section">
        <div class="container company-grid">
          <div id="team" class="company-block">
            <p class="section-label">TEAM</p>
            <h2>{{ lang.team.title }}</h2>
            <div class="team-list">
              {% for member in lang.team.members %}
              <div class="team-list-item">
                <div class="team-item-info">
                  <strong class="team-item-name">{{ member.name }}</strong>
                  <span class="team-item-title">{{ member.title }}</span>
                </div>
                <div class="team-item-socials">
                  {% if member.socials and member.socials.linkedin %}
                  <a href="{{ member.socials.linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="{{ member.name }} LinkedIn">
                    <img src="/images/icon-linkedin.svg" alt="" width="18" height="18" />
                  </a>
                  {% endif %}
                  {% if member.socials and member.socials.github %}
                  <a href="{{ member.socials.github }}" target="_blank" rel="noopener noreferrer" aria-label="{{ member.name }} GitHub">GitHub</a>
                  {% endif %}
                </div>
              </div>
              {% endfor %}
            </div>
          </div>
          <div id="company-profile" class="company-block">
            <p class="section-label">COMPANY</p>
            <h2>{{ lang.companyProfile.title }}</h2>
            <dl class="company-data">
              <div><dt>{{ lang.companyProfile.nameLabel }}</dt><dd>{{ lang.companyProfile.name }}</dd></div>
              <div><dt>{{ lang.companyProfile.foundedLabel }}</dt><dd>{{ lang.companyProfile.founded }}</dd></div>
              <div><dt>{{ lang.companyProfile.ceoLabel }}</dt><dd>{{ lang.companyProfile.ceo }}</dd></div>
              <div><dt>{{ lang.companyProfile.addressLabel }}</dt><dd>{{ lang.companyProfile.address }}</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <section id="contact" class="contact-band">
        <div class="container contact-band-layout">
          <div>
            <p class="section-label section-label-light">CONTACT</p>
            <h2>{% if lang.key == 'ja' %}研究についてご相談ください。{% else %}Talk to us about research.{% endif %}</h2>
          </div>
          <div>
            <p>{% if lang.key == 'ja' %}参加者募集や研究支援についてご相談ください。{% else %}Ask us about recruitment or research support.{% endif %}</p>
            <a href="{{ lang.footer.contactLink }}" class="btn btn-light" target="_blank" rel="noopener noreferrer">{{ lang.footer.contact }}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-top">
        <a href="{% if lang.key == 'ja' %}/{% else %}/{{ lang.key }}/{% endif %}" class="footer-brand" aria-label="Researchin {% if lang.key == 'ja' %}ホーム{% else %}home{% endif %}">
          {% image "static/logo.png", "Researchin", "160px" %}
        </a>
        <a href="mailto:{{ lang.footer.contactEmail }}" class="footer-email">{{ lang.footer.contactEmail }}</a>
      </div>
      <div class="container footer-bottom">
        <div class="footer-links">
          <a href="{% if lang.key == 'en' %}/en/terms/{% else %}/terms/{% endif %}">{{ lang.footer.terms }}</a>
          <a href="{% if lang.key == 'en' %}/en/privacy/{% else %}/privacy/{% endif %}">{{ lang.footer.privacy }}</a>
        </div>
        <p>&copy; <span id="currentYear"></span> {{ lang.meta.siteName }} Inc.</p>
      </div>
    </footer>
  </div>

  <script>
    document.getElementById('currentYear').textContent = new Date().getFullYear();

    const mobileSidebar = document.getElementById('mobile-sidebar');
    const hamburgerBtn = document.getElementById('hamburger-menu');
    const closeMenuBtn = document.getElementById('menu-close-btn');
    const overlay = document.getElementById('sidebar-overlay');
    const menuLinks = document.querySelectorAll('.menu-link');

    const openMenu = () => {
      mobileSidebar.classList.add('is-open');
      overlay.classList.add('is-open');
      mobileSidebar.setAttribute('aria-hidden', 'false');
      mobileSidebar.inert = false;
      hamburgerBtn.setAttribute('aria-expanded', 'true');
      document.body.classList.add('menu-open');
      closeMenuBtn.focus();
    };

    const closeMenu = () => {
      mobileSidebar.classList.remove('is-open');
      overlay.classList.remove('is-open');
      mobileSidebar.setAttribute('aria-hidden', 'true');
      mobileSidebar.inert = true;
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-open');
    };

    hamburgerBtn.addEventListener('click', openMenu);
    closeMenuBtn.addEventListener('click', () => { closeMenu(); hamburgerBtn.focus(); });
    overlay.addEventListener('click', closeMenu);
    menuLinks.forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileSidebar.classList.contains('is-open')) {
        closeMenu();
        hamburgerBtn.focus();
      }
      if (event.key === 'Tab' && mobileSidebar.classList.contains('is-open')) {
        const focusable = Array.from(mobileSidebar.querySelectorAll('a[href], button:not([disabled])'));
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  </script>
</body>
</html>
